# Select mock for development or hf for pretrained models.
DETECTOR_BACKEND=mock
# Hugging Face image-classification and audio-classification model ids.
FACE_MODEL_ID=
AUDIO_MODEL_ID=
# Optional exact fake class name/index (for example: fake, spoof, or 1).
FACE_FAKE_LABEL=
AUDIO_FAKE_LABEL=
# Raw model probability mapped to calibrated score 0.5.
FACE_THRESHOLD=0.5
AUDIO_THRESHOLD=0.5
# auto selects CUDA when available; otherwise CPU.
HF_DEVICE=auto
# Audio inference window duration; evaluation uses this duration with 1s hops.
AUDIO_WINDOW_SEC=2
MAX_FRAME_BYTES=2000000
MAX_AUDIO_BYTES=1500000
HOST=127.0.0.1
PORT=8000
